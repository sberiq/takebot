# Создайте своего бота через https://t.me/BotFather и задайте токен ниже.
MAIN_BOT_TOKEN=

# Числовой Telegram ID владельца этой установки.
ADMIN_ID=

# Docker Compose переопределяет путь и хранит базу в volume /data.
DATABASE_PATH=bot_constructor.db

# По умолчанию основным ботом пользуется только владелец этой установки.
INSTANCE_OWNER_ONLY=true

# Для Bot Management Mode включите соответствующий режим в @BotFather.
BOT_MANAGEMENT_ENABLED=false
BOT_MANAGEMENT_DEFAULT_NAME=Suggestions Bot

GEMINI_MODEL=gemini-3.8-flash
